    {
      "id": "lion",
      "title": "The Lion",
      "short": "Half cut off by the edge of the canvas, it lies at Christ’s feet.",
      "extended": "Lions are among the wild beasts the Met identifies in the painting. In Christian art the lion can stand for strength and kingship, and the same verse of Psalm 91 that names the basilisk promises that the lion will be trampled. Here it is calm, which suits a reading of the wilderness as a place where creation is at peace with Christ.",
      "references": [
        "Mark 1:13",
        "Psalm 91:13"
      ],
      "evidence": "iconographicTradition",
