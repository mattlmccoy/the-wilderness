<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.mattmccoy.wilderness.refresh</string>
  <key>ProgramArguments</key>
  <array><string>/Users/mattmccoy/Developer/Wilderness/scripts/refresh.sh</string></array>
  <!-- Checks daily at 17:30 (or on wake if the Mac slept through it). refresh.sh installs only
       when 6+ days have passed and only 2 pm-10 pm: weekly, never at night. -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>30</integer></dict>
</dict>
</plist>
